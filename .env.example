# Where the Next.js server proxies /api/v1/* to.
BACKEND_URL=http://localhost:8080

# Address of the analytics (Metabase) site, e.g. https://analytics.example.com. The page asks the API for a signed
# dashboard link and frames it only from this site. Fixed in at build time; the release workflow reads the
# ANALYTICS_URL repository variable. Setup: backend docs/ANALYTICS.md.
NEXT_PUBLIC_ANALYTICS_URL=
