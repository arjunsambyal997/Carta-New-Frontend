{
  "name": "carta-new-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "dev-token": "node scripts/dev-token.mjs",
    "lint": "oxlint",
    "format": "prettier --write src e2e",
    "format:check": "prettier --check src e2e",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "prepare": "husky"
  },
  "dependencies": {
    "next": "15.5.28",
    "qrcode.react": "4.2.0",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "@vitest/coverage-v8": "5.0.5",
    "autoprefixer": "10.4.20",
    "husky": "9.1.7",
    "jsdom": "29.1.1",
    "lint-staged": "16.4.0",
    "oxlint": "1.88.0",
    "postcss": "8.5.28",
    "prettier": "3.9.10",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3",
    "vitest": "5.0.5"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx,css}": "prettier --write",
    "src/**/*.{ts,tsx}": "oxlint"
  },
  "engines": {
    "node": ">=20"
  }
}
