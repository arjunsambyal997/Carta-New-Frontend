{
  "name": "carta-new-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "dev-token": "node scripts/dev-token.mjs",
    "lint": "oxlint",
    "format": "prettier --write src e2e",
    "format:check": "prettier --check src e2e",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "prepare": "husky",
    "test:e2e:live": "playwright test -c playwright.live.config.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-tooltip": "1.4.1",
    "lucide-react": "1.59.0",
    "motion": "14.2.0",
    "next": "16.4.3",
    "qrcode.react": "4.2.0",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.15.21",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "@vitest/coverage-v8": "5.0.5",
    "autoprefixer": "10.4.20",
    "husky": "9.1.7",
    "jsdom": "30.1.3",
    "lint-staged": "17.6.0",
    "oxlint": "1.88.0",
    "postcss": "8.5.30",
    "prettier": "3.9.10",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3",
    "vitest": "5.0.5"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx,css}": "prettier --write",
    "src/**/*.{ts,tsx}": "oxlint"
  },
  "engines": {
    "node": ">=20"
  }
}
